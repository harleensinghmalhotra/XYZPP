# Dependencies
node_modules/

# Build output (Vercel rebuilds it)
dist/

# Sanity Studio — secrets & build artifacts (studio/ is its own package)
studio/.env
studio/.env.*
studio/dist/
studio/.sanity/
.sanity/

# Local environment — the Vite Sanity read token lives here. Never commit.
.env.local
.env.*.local

# Never commit a plaintext token/secret file
*API Key*.txt
*api key*.txt

# Editor / tooling
.claude/
.agents/

# Local, non-shipping working material (backups, scratch, source dumps)
_archive/

# Local verification / asset-prep scratch (one-off Playwright + transcode harnesses).
# Ignore contents via a glob, not the directory itself (`scripts/`) — negating a
# file below an excluded *directory* doesn't work in git; excluding its
# contents does, which is what lets the exception below actually take effect.
scripts/*
# ...except the prerender step and the sitemap generator: real build
# dependencies (package.json's "build" script requires both), not one-off
# dev/verification harnesses — must ship, unlike everything else in this
# directory.
!scripts/prerender.mjs
!scripts/generate-sitemap.mjs

# Root-level image scratch (screenshots). Real bundler assets under src/assets and
# the client-swap deliverable tree under public/site-assets must always ship.
*.png
!src/assets/**
!public/site-assets/**
