{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm build && pnpm exec vite preview --host 127.0.0.1 --port 4319 --strictPort",
      "startServerReadyPattern": "Local",
      "startServerReadyTimeout": 180000,
      "url": [
        "http://127.0.0.1:4319/",
        "http://127.0.0.1:4319/fulfilment",
        "http://127.0.0.1:4319/infrastructure",
        "http://127.0.0.1:4319/contact"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://127\\.0\\.0\\.1:4319/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.42, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
            "viewport": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "target-size": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "total-byte-weight": ["error", { "maxNumericValue": 2944536, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/fulfilment$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.50, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
            "viewport": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "target-size": ["error", { "minScore": 1, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/infrastructure$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.54, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.93, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
            "viewport": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "target-size": ["error", { "minScore": 1, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/contact$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.58, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
            "viewport": ["error", { "minScore": 1, "aggregationMethod": "median" }],
            "target-size": ["error", { "minScore": 1, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
